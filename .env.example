# Supabase › Project Settings › API (no Railway: domínio público do gateway Envoy)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# (Railway) URL pública do serviço edge/ das funções; vazio = usa as Edge Functions do Supabase
# VITE_FUNCOES_URL=https://sedentos-edge.up.railway.app
# Notificações push (gere com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
# (Opcional) Domínio técnico do login dos secretários; igual ao segredo SECRETARIO_DOMINIO da função
# VITE_SECRETARIO_DOMINIO=chamada.sedentos.app

# Só para o script de importação (NUNCA coloque no deploy do front)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
ADMIN_EMAIL=lideranca@exemplo.com
